{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "com.metaxiii.fr*"
      ],
      "matchUpdateTypes": ["patch", "minor"],
      "matchCurrentVersion": "!/^0/",
      "minimumReleaseAge": "3 days",
      "automerge": true
    }
  ]
}
